<!DOCTYPE html>

<html lang="es"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Mind Refresh - Acceso al Ecosistema de Bienestar</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "error": "#dc2626",
                        "primary-fixed-dim": "#a5b4fc",
                        "on-tertiary-fixed": "#2e1065",
                        "on-primary": "#ffffff",
                        "on-surface": "#2e3040",
                        "surface-dim": "#d4d6dc",
                        "surface-container-low": "#e5e7ed",
                        "surface-container": "#e2e4ea",
                        "secondary-fixed": "#d8dae6",
                        "tertiary": "#7c3aed",
                        "inverse-primary": "#a5b4fc",
                        "primary-container": "#818cf8",
                        "inverse-on-surface": "#e8eaf0",
                        "outline-variant": "#d0d2dc",
                        "on-tertiary": "#ffffff",
                        "background": "#e8eaf0",
                        "secondary": "#6c6e7e",
                        "inverse-surface": "#2e3040",
                        "surface-tint": "#6366f1",
                        "on-error": "#ffffff",
                        "surface": "#e8eaf0",
                        "tertiary-container": "#a78bfa",
                        "on-primary-fixed": "#1e1b4b",
                        "tertiary-fixed": "#ede9fe",
                        "on-tertiary-fixed-variant": "#5b21b6",
                        "surface-container-lowest": "#f0f2f8",
                        "surface-container-highest": "#d6d8de",
                        "tertiary-fixed-dim": "#c4b5fd",
                        "on-secondary": "#ffffff",
                        "primary": "#6366f1",
                        "on-surface-variant": "#585a68",
                        "on-secondary-container": "#585a68",
                        "error-container": "#fee2e2",
                        "primary-fixed": "#e0e2ff",
                        "on-primary-container": "#e0e2ff",
                        "on-error-container": "#991b1b",
                        "on-background": "#2e3040",
                        "surface-container-high": "#dcdee4",
                        "surface-bright": "#edeef4",
                        "secondary-fixed-dim": "#b8baca",
                        "outline": "#8a8c9a",
                        "on-tertiary-container": "#3b1f63",
                        "surface-variant": "#dcdee4",
                        "on-secondary-fixed-variant": "#404252",
                        "on-secondary-fixed": "#1a1b26",
                        "secondary-container": "#d8dae6",
                        "on-primary-fixed-variant": "#4338ca"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Plus Jakarta Sans"],
                        "display": ["Plus Jakarta Sans"],
                        "body": ["Plus Jakarta Sans"],
                        "label": ["Plus Jakarta Sans"]
                    }
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center p-4">
<!-- Main Container -->
<main class="w-full max-w-md">
<!-- Neomorphic Card -->
<div class="bg-surface rounded-xl p-8 shadow-[6px_6px_12px_rgba(0,0,0,0.08),-6px_-6px_12px_rgba(255,255,255,0.6)] flex flex-col gap-8">
<!-- Header Section -->
<header class="text-center">
<div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-surface shadow-[6px_6px_12px_rgba(0,0,0,0.08),-6px_-6px_12px_rgba(255,255,255,0.6)] mb-4">
<span class="material-symbols-outlined text-3xl text-primary" data-icon="spa">spa</span>
</div>
<h1 class="font-headline text-2xl font-semibold text-on-surface mb-2">Mind Refresh</h1>
<p class="font-body text-on-surface-variant text-sm">Acceso al Ecosistema de Bienestar</p>
</header>
<!-- Authentication Form -->
<form class="flex flex-col gap-5">
<!-- Email Input -->
<div class="flex flex-col gap-2">
<label class="font-label text-sm font-medium text-on-surface-variant px-1" for="email">Correo Corporativo</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-on-surface-variant" data-icon="mail">mail</span>
<input class="w-full bg-surface text-on-surface pl-12 pr-4 py-3 rounded-lg border-none focus:ring-0 shadow-[inset_4px_4px_8px_rgba(0,0,0,0.06),inset_-4px_-4px_8px_rgba(255,255,255,0.5)] placeholder-on-surface-variant/50 focus:outline-none transition-shadow" id="email" name="email" placeholder="nombre@empresa.com" type="email"/>
</div>
</div>
<!-- Password Input -->
<div class="flex flex-col gap-2">
<div class="flex justify-between items-center px-1">
<label class="font-label text-sm font-medium text-on-surface-variant" for="password">Contraseña</label>
<a class="font-label text-xs font-medium text-primary hover:text-tertiary transition-colors" href="#">¿Olvidaste tu contraseña?</a>
</div>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-on-surface-variant" data-icon="lock">lock</span>
<input class="w-full bg-surface text-on-surface pl-12 pr-4 py-3 rounded-lg border-none focus:ring-0 shadow-[inset_4px_4px_8px_rgba(0,0,0,0.06),inset_-4px_-4px_8px_rgba(255,255,255,0.5)] placeholder-on-surface-variant/50 focus:outline-none transition-shadow" id="password" name="password" placeholder="••••••••" type="password"/>
</div>
</div>
<!-- Submit Button -->
<button class="w-full mt-2 bg-surface text-primary font-label font-semibold py-3 px-6 rounded-lg shadow-[6px_6px_12px_rgba(0,0,0,0.08),-6px_-6px_12px_rgba(255,255,255,0.6)] active:shadow-[inset_4px_4px_8px_rgba(0,0,0,0.06),inset_-4px_-4px_8px_rgba(255,255,255,0.5)] transition-all duration-200 flex justify-center items-center gap-2" type="submit">
<span>Iniciar Sesión</span>
<span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
</button>
</form>
<!-- Divider -->
<div class="flex items-center gap-4 w-full">
<div class="h-px bg-surface-variant flex-1 shadow-[inset_0px_1px_1px_rgba(0,0,0,0.05)]"></div>
<span class="font-label text-xs text-on-surface-variant uppercase tracking-wider">o</span>
<div class="h-px bg-surface-variant flex-1 shadow-[inset_0px_1px_1px_rgba(0,0,0,0.05)]"></div>
</div>
<!-- SSO Integration -->
<button class="w-full bg-surface text-on-surface font-label font-medium py-3 px-6 rounded-lg shadow-[6px_6px_12px_rgba(0,0,0,0.08),-6px_-6px_12px_rgba(255,255,255,0.6)] active:shadow-[inset_4px_4px_8px_rgba(0,0,0,0.06),inset_-4px_-4px_8px_rgba(255,255,255,0.5)] transition-all duration-200 flex justify-center items-center gap-3" type="button">
<span class="material-symbols-outlined text-[#4A5568]" data-icon="groups">groups</span>
                Ingresar con Microsoft Teams
            </button>
</div>
<!-- Privacy Disclaimer -->
<div class="mt-8 text-center px-4 flex flex-col items-center gap-2">
<span class="material-symbols-outlined text-on-surface-variant/70 text-xl" data-icon="shield_lock">shield_lock</span>
<p class="font-body text-xs text-on-surface-variant leading-relaxed">
                Tus datos emocionales individuales son tratados de forma anónima en reportes grupales.
            </p>
</div>
</main>
</body></html>